@page "/pacientes"
@rendermode InteractiveServer
@using AMUI.Models
@using AMUI.Services
@inject PacienteService PacienteService
@inject IJSRuntime JSRuntime

<h3>Pacientes</h3>

<a href="pacientes/crear" class="btn btn-primary mt-2 mb-2">Crear Paciente</a>

@if (pacientes == null)
{
    <p>Cargando...</p>
}
else if (!pacientes.Any())
{
    <p>No hay pacientes.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0 table-bordered">
            <tr>
                <th>Nombre del paciente</th>
                <th>Telefono</th>
                <th>Correo</th>
                <th>Acción</th>
            </tr>
            @foreach (var paciente in pacientes)
            {
                <tr>
                    <td>@paciente.Nombre</td>
                    <td>@paciente.Correo</td>
                    <td>@paciente.Telefono</td>
                    <td>
                        <a class="btn btn-primary" type="button" href="pacientes/editar/@paciente.Id">Editar</a>
                        <button class="btn btn-danger" type="button" @onclick="() => EliminarPaciente(paciente.Id)">
                            Borrar
                        </button>
                        <a class="btn btn-info" type="button" href="pacientes/historial/@paciente.Id">Historial</a>
                    </td>
                </tr>
            
            }
        </table>
    </div>
}

@code {
    private List<PacienteDto>? pacientes;

    protected override async Task OnInitializedAsync()
    {
        pacientes = await PacienteService.GetPacientesAsync();
    }

    private async Task EliminarPaciente(int id)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "¿Estás seguro de que deseas eliminar este paciente?");
        if (confirm)
        {
            var result = await PacienteService.DeletePacienteAsync(id);
            var message = result.Completed ? "Paciente eliminado exitosamente." : result.Message;
            await JSRuntime.InvokeVoidAsync("alert", message);
            pacientes = await PacienteService.GetPacientesAsync();
        }
    }
}
@page "/medico/editar/{id:int}"
@using AMUI.Models
@using AMUI.Services
@inject MedicosService MedicosService
@inject EspecialidadesService EspecialidadesService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<h3>Actualizar datos del médico</h3>

<div class="container">
    <input type="text" class="form-control mt-2 mb-2" @bind-value="@medico.Nombre" placeholder="Nombre" />

    <select class="form-control mt-2 mb-2" @onchange="OnSelectEspecialidad">
        <option value="">Elige una especialidad</option>

        @if (Especialidades is not null)
        {
            @foreach (var especialidad in Especialidades)
            {
                <option value="@especialidad.Id" selected="@(medico.EspecialidadId == especialidad.Id)">
                    @especialidad.Nombre
                </option>
            }
        }
    </select>

    <p>Indica los horarios de trabajo disponibles para la especialidad seleccionada:</p>

    @if (horarios.Any())
    {
        <div class="row mt-2 mb-2">
            @foreach (var ds in diasSemana)
            {
                <div class="col">
                    <div class="card">
                        <div class="card-header">
                            <strong>@ds</strong>
                        </div>

                        <div class="card-body">
                            @foreach (var horario in horarios)
                            {
                                var idCheck = $"{ds}_{horario}".Replace(":", "").Replace(" ", "");

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="@idCheck"
                                           checked="@horariosSeleccionadosPorDia[ds].Contains(horario)"
                                           @onchange="(e) => OnHorarioSeleccionado(ds, horario, e)" />

                                    <label class="form-check-label" for="@idCheck">
                                        @horario
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="d-inline-block justify-content-left align-items-center">
    <button class="btn btn-primary" @onclick="ActualizarMedico">Editar</button>
    <a class="btn btn-danger" href="/medicos">Cancelar</a>
</div>


@code {
    [Parameter]
    public int Id { get; set; }

    private MedicoCreacionDto medico = new MedicoCreacionDto();
    public List<EspecialidadDto> Especialidades { get; set; } = new();
    private List<string> horarios = new();
    private List<string> diasSemana = new() { "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo" };
    private Dictionary<string, HashSet<string>> horariosSeleccionadosPorDia = new();
    private EspecialidadDto? EspecialidadSeleccionada { get; set; }

    protected override async Task OnInitializedAsync()
    {
        foreach (var dia in diasSemana)
        {
            horariosSeleccionadosPorDia[dia] = new HashSet<string>();
        }

        Especialidades = await EspecialidadesService.GetEspecialidadesAsync() ?? new List<EspecialidadDto>();

        var medicoDto = await MedicosService.GetMedicoByIdAsync(Id) ?? new MedicoDto();

        var horariosMedico = await MedicosService.GetHorarioMedicodesAsync(Id) ?? new List<HorarioMedicoCreacionDto>();

        medico = new MedicoCreacionDto
        {
            Id = medicoDto.Id,
            Nombre = medicoDto.Nombre,
            EspecialidadId = medicoDto.Especialidad?.Id ?? 0,
            Horarios = horariosMedico
        };

        if (medico.EspecialidadId > 0)
        {
            EspecialidadSeleccionada = Especialidades.FirstOrDefault(x => x.Id == medico.EspecialidadId);

            if (EspecialidadSeleccionada is not null)
            {
                CalcularHorariosDisponibles(EspecialidadSeleccionada.DuracionMinutos);
                PrecargarHorariosSeleccionados(medico.Horarios);
            }
        }
    }

    private async Task ActualizarMedico()
    {
        medico.Horarios = ConstruirHorariosMedico();

        var result = await MedicosService.UpdateMedicoAsync(medico);
        var message = result.Completed ? "Médico actualizado exitosamente." : result.Message;

        await JSRuntime.InvokeVoidAsync("alert", message);

        if (result.Completed)
        {
            NavigationManager.NavigateTo("/medicos");
        }
    }

    private void OnSelectEspecialidad(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString();

        if (int.TryParse(valor, out int id))
        {
            medico.EspecialidadId = id;

            EspecialidadSeleccionada = Especialidades.FirstOrDefault(x => x.Id == id);

            if (EspecialidadSeleccionada is not null)
            {
                CalcularHorariosDisponibles(EspecialidadSeleccionada.DuracionMinutos);

                foreach (var dia in diasSemana)
                {
                    horariosSeleccionadosPorDia[dia].Clear();
                }
            }
        }
        else
        {
            medico.EspecialidadId = 0;
            EspecialidadSeleccionada = null;
            horarios.Clear();

            foreach (var dia in diasSemana)
            {
                horariosSeleccionadosPorDia[dia].Clear();
            }
        }
    }

    private void CalcularHorariosDisponibles(int duracionMinutos)
    {
        var horaInicio = new TimeSpan(8, 0, 0);
        var horaFin = new TimeSpan(19, 0, 0);

        horarios.Clear();

        for (var hora = horaInicio; hora.Add(TimeSpan.FromMinutes(duracionMinutos)) <= horaFin; hora = hora.Add(TimeSpan.FromMinutes(duracionMinutos)))
        {
            horarios.Add(hora.ToString(@"hh\:mm"));
        }
    }

    private void OnHorarioSeleccionado(string dia, string horario, ChangeEventArgs e)
    {
        var seleccionado = e.Value is bool b && b;

        if (seleccionado)
        {
            horariosSeleccionadosPorDia[dia].Add(horario);
        }
        else
        {
            horariosSeleccionadosPorDia[dia].Remove(horario);
        }
    }

    private void PrecargarHorariosSeleccionados(List<HorarioMedicoCreacionDto>? horariosGuardados)
    {
        if (horariosGuardados is null || !horariosGuardados.Any())
            return;

        foreach (var dia in diasSemana)
        {
            horariosSeleccionadosPorDia[dia].Clear();
        }

        foreach (var horario in horariosGuardados)
        {
            if (string.IsNullOrWhiteSpace(horario.DiaSemana))
                continue;

            if (!horariosSeleccionadosPorDia.ContainsKey(horario.DiaSemana))
                continue;

            var hora = horario.HoraInicio.ToString(@"hh\:mm");

            if (horarios.Contains(hora))
            {
                horariosSeleccionadosPorDia[horario.DiaSemana].Add(hora);
            }
        }
    }

    private List<HorarioMedicoCreacionDto> ConstruirHorariosMedico()
    {
        var lista = new List<HorarioMedicoCreacionDto>();

        if (EspecialidadSeleccionada is null)
            return lista;

        foreach (var dia in diasSemana)
        {
            foreach (var hora in horariosSeleccionadosPorDia[dia].OrderBy(x => x))
            {
                if (TimeSpan.TryParse(hora, out var horaInicioTime))
                {
                    var horaInicio = horaInicioTime;
                    var horaFin = horaInicio.Add(TimeSpan.FromMinutes(EspecialidadSeleccionada.DuracionMinutos));

                    lista.Add(new HorarioMedicoCreacionDto
                    {
                        DiaSemana = dia,
                        HoraInicio = horaInicio,
                        HoraFin = horaFin,
                        MedicoId = medico.Id
                    });
                }
            }
        }

        return lista;
    }
}